{
  "id": "com.raphandco.leman",
  "version": "1.1.2",
  "sdk": 3,
  "compatibility": ">=10.0.0",
  "platforms": [
    "local"
  ],
  "author": {
    "name": "Gemini CLI",
    "email": "homey@raphandco.local"
  },
  "name": {
    "en": "Lac Léman Monitor",
    "fr": "Moniteur du Lac Léman"
  },
  "description": {
    "en": "Track Lake Geneva temperature and water level.",
    "fr": "Suivi de la température et du niveau d'eau du Lac Léman."
  },
  "category": [
    "energy",
    "climate"
  ],
  "brandColor": "#1565C0",
  "images": {
    "small": "/assets/icon.svg",
    "large": "/assets/icon.svg"
  },
  "capabilities": {
    "measure_water_level": {
      "type": "number",
      "title": {
        "en": "Water Level",
        "fr": "Niveau d'eau"
      },
      "units": "m",
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/water_height.svg"
    },
    "measure_water_level_diff": {
      "type": "number",
      "title": {
        "en": "Diff vs Summer Avg",
        "fr": "Diff vs Moyenne Été"
      },
      "units": "cm",
      "decimals": 0,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/water_height.svg"
    },
    "alarm_kite": {
      "type": "boolean",
      "title": {
        "en": "Kite Conditions",
        "fr": "Conditions Kite"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/kite.svg"
    },
    "measure_wind_max": {
      "type": "number",
      "title": {
        "en": "Max Wind Forecast",
        "fr": "Vent Max Prévu"
      },
      "units": "kn",
      "decimals": 1,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/wind.svg"
    },
    "measure_wind_gust_max": {
      "type": "number",
      "title": {
        "en": "Max Gust Forecast",
        "fr": "Rafale Max Prévue"
      },
      "units": "kn",
      "decimals": 1,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/wind.svg"
    },
    "measure_wind_direction": {
      "type": "number",
      "title": {
        "en": "Wind Direction",
        "fr": "Direction du Vent"
      },
      "units": "°",
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/compass.svg"
    },
    "measure_wind_direction_text": {
      "type": "string",
      "title": {
        "en": "Wind Name",
        "fr": "Nom du Vent"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/compass.svg"
    },
    "alarm_strong_wind": {
      "type": "boolean",
      "title": {
        "en": "Strong Wind Alarm",
        "fr": "Alerte Vent Fort"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/wind.svg"
    },
    "alarm_pump_foil": {
      "type": "boolean",
      "title": {
        "en": "Pump Foil Conditions",
        "fr": "Conditions Pump Foil"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/foil.svg"
    }
  },
  "drivers": [
    {
      "id": "leman",
      "name": {
        "en": "Lac Léman",
        "fr": "Lac Léman"
      },
      "class": "sensor",
      "capabilities": [
        "alarm_pump_foil",
        "alarm_kite",
        "alarm_strong_wind",
        "measure_temperature",
        "measure_water_level",
        "measure_water_level_diff",
        "measure_wind_max",
        "measure_wind_gust_max",
        "measure_wind_direction",
        "measure_wind_direction_text"
      ],
      "images": {
        "small": "/assets/icon.svg",
        "large": "/assets/icon.svg"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    }
  ]
}
